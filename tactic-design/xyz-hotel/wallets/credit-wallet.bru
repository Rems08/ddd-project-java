meta {
  name: Credit Wallet
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/wallets/{{accountId}}/credit
  body: json
  auth: inherit
}

body:json {
  {
    "amount": 500.00,
    "currency": "EUR"
  }
}

vars:pre-request {
  accountId: 8c8f3bc0-3443-4d0d-a83d-51362c0e0796
}

settings {
  encodeUrl: true
  timeout: 0
}
